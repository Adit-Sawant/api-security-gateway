# Application
NODE_ENV=development
PORT=3000

# PostgreSQL
POSTGRES_USER=gateway_user
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_DB=gateway_db
DATABASE_URL=postgresql://gateway_user:replace_with_secure_password@localhost:5432/gateway_db?schema=public

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=15m

# Backend services
USER_SERVICE_URL=
ORDER_SERVICE_URL=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_secure_redis_password
REDIS_DB=0

# Rate Limiting
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_FREE=60
RATE_LIMIT_PRO=600
RATE_LIMIT_ENTERPRISE=3000
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5

# Grafana
GRAFANA_ADMIN_PASSWORD=replace_with_secure_grafana_password
GRAFANA_SMTP_PASSWORD=replace_with_gmail_app_password